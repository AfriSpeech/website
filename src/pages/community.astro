---
import Base from '../layouts/Base.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const SLACK_INVITE = 'https://join.slack.com/t/africanlp/shared_invite/zt-488w1yzj6-ui~rrekZQmavOujYh6x_~w';
---

<Base
  title="Africa NLP Community"
  description="Join the Africa NLP community. Connect with researchers, engineers, and linguists building foundational tools for African languages."
>
  <Navigation slot="nav" />

  <section class="pt-24 pb-16 sm:pt-28 sm:pb-20 bg-mist">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl font-bold text-neutral-900 tracking-tight mb-4">Join the Africa NLP Community</h1>
        <p class="text-lg text-neutral-600 leading-relaxed max-w-2xl">
          AfriSpeech hosts the Africa NLP community that brings together researchers, engineers,
          linguists, and builders working to make African languages thrive in AI. Our members are
          building the foundational tools that power Africa&rsquo;s AI. To join the community,
          please complete the form below.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-paper">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-xl">
        <form id="join-form" class="space-y-5" novalidate>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="first-name" class="block text-sm font-semibold text-neutral-900 mb-1.5">First name</label>
              <input
                id="first-name"
                name="firstName"
                type="text"
                required
                autocomplete="given-name"
                placeholder="Ama"
                class="w-full px-4 py-3 text-base rounded-card border border-mist-200 bg-white text-ink-700 placeholder-sage focus:outline-none focus:border-forest transition-colors"
              />
            </div>

            <div>
              <label for="last-name" class="block text-sm font-semibold text-neutral-900 mb-1.5">Last name</label>
              <input
                id="last-name"
                name="lastName"
                type="text"
                required
                autocomplete="family-name"
                placeholder="Mensah"
                class="w-full px-4 py-3 text-base rounded-card border border-mist-200 bg-white text-ink-700 placeholder-sage focus:outline-none focus:border-forest transition-colors"
              />
            </div>
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-neutral-900 mb-1.5">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="you@example.com"
              class="w-full px-4 py-3 text-base rounded-card border border-mist-200 bg-white text-ink-700 placeholder-sage focus:outline-none focus:border-forest transition-colors"
            />
            <p class="mt-1.5 text-sm text-neutral-600">
              Use the same email you would like to use to join our Slack community.
            </p>
          </div>

          <div>
            <label for="language-search" class="block text-sm font-semibold text-neutral-900 mb-1.5">
              Which languages are you building for?
            </label>
            <div class="relative" id="language-combo">
              <div
                id="language-field"
                class="w-full flex flex-wrap items-center gap-2 pl-2 pr-10 py-2 max-h-56 overflow-y-auto rounded-card border border-mist-200 bg-white focus-within:border-forest transition-colors"
              >
                <ul id="language-chips" class="contents" aria-label="Selected languages"></ul>
                <input
                  id="language-search"
                  type="text"
                  role="combobox"
                  autocomplete="off"
                  aria-expanded="false"
                  aria-controls="language-listbox"
                  aria-autocomplete="list"
                  placeholder="Start typing a language or ISO code..."
                  class="flex-1 min-w-[12rem] px-2 py-1.5 text-base bg-transparent text-ink-700 placeholder-sage focus:outline-none"
                />
              </div>
              <input type="hidden" id="language-codes" name="languageCodes" value="" />
              <button
                type="button"
                id="language-toggle"
                tabindex="-1"
                aria-label="Show languages"
                class="absolute top-0 right-0 h-[3.25rem] flex items-center px-3 text-sage hover:text-forest transition-colors"
              >
                <svg id="language-chevron" class="w-4 h-4 transition-transform" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 7.5 10 12.5 15 7.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <ul
                id="language-listbox"
                role="listbox"
                aria-label="African languages"
                aria-multiselectable="true"
                class="hidden absolute z-20 left-0 right-0 mt-1 max-h-72 overflow-y-auto rounded-card border border-mist-200 bg-white shadow-lg py-1"
              ></ul>
            </div>
            <div class="mt-1.5 flex items-start justify-between gap-4">
              <p class="text-sm text-neutral-600">
                Add as many as you work on, or type a country to add every language spoken there.
              </p>
              <button
                type="button"
                id="language-clear"
                class="hidden shrink-0 text-sm font-semibold text-neutral-600 hover:text-forest-800 transition-colors"
              >
                Clear all
              </button>
            </div>
          </div>

          <div>
            <label for="reason" class="block text-sm font-semibold text-neutral-900 mb-1.5">Why do you want to join the community?</label>
            <textarea
              id="reason"
              name="reason"
              rows="4"
              required
              placeholder="Tell us what you are building or working on in African languages and NLP..."
              class="w-full px-4 py-3 text-base rounded-card border border-mist-200 bg-white text-ink-700 placeholder-sage focus:outline-none focus:border-forest transition-colors resize-y"
            ></textarea>
          </div>

          <p id="form-error" class="hidden text-base text-red-500"></p>

          <button
            type="submit"
            class="inline-flex items-center justify-center px-6 py-3 rounded-md bg-forest-700 text-white text-sm font-semibold hover:bg-forest-800 transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
          >
            Request to join
          </button>
        </form>

        <div id="join-success" class="hidden p-8 rounded-card border border-mist-200 bg-white">
          <h2 class="text-2xl font-bold text-neutral-900 mb-3">Thank you!</h2>
          <p class="text-base text-neutral-600 leading-relaxed mb-5">
            We have sent a welcome email to your inbox. To finish joining, click the button below
            to open your Slack invite.
          </p>
          <a
            id="join-invite"
            href={SLACK_INVITE}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center px-6 py-3 rounded-md bg-forest-700 text-white text-sm font-semibold hover:bg-forest-800 transition-colors"
          >
            Join the Africa NLP Slack
          </a>
          <p class="text-base text-neutral-600 leading-relaxed mt-5">
            Once you are in, introduce yourself on the <strong class="text-ink-700">#introductions</strong>
            channel and share a little about what you are doing in NLP.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<script>
  const form = document.getElementById('join-form');
  const errorBox = document.getElementById('form-error');
  const success = document.getElementById('join-success');

  if (form && success) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.add('hidden');
      const payload = {
        firstName: document.getElementById('first-name').value,
        lastName: document.getElementById('last-name').value,
        email: document.getElementById('email').value,
        languageCodes: document.getElementById('language-codes').value.split(',').filter(Boolean),
        reason: document.getElementById('reason').value,
      };

      if (!payload.languageCodes.length) {
        errorBox.textContent = 'Please choose at least one language from the list.';
        errorBox.classList.remove('hidden');
        document.getElementById('language-search').focus();
        return;
      }

      const btn = form.querySelector('button[type="submit"]');
      btn.disabled = true;
      btn.textContent = 'Sending...';

      try {
        const res = await fetch('/.netlify/functions/join-community', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          const invite = document.getElementById('join-invite');
          if (invite && data.slackInvite) invite.href = data.slackInvite;
          form.classList.add('hidden');
          success.classList.remove('hidden');
        } else {
          errorBox.textContent = data.error || 'Something went wrong. Please try again.';
          errorBox.classList.remove('hidden');
        }
      } catch (err) {
        errorBox.textContent = 'Could not reach the server. Please try again.';
        errorBox.classList.remove('hidden');
      }

      btn.disabled = false;
      btn.textContent = 'Request to join';
    });
  }
</script>

<script>
  import {
    LANGUAGES,
    OTHER_LANGUAGE,
    COUNTRY_NAMES,
    countryNamesFor,
  } from '../data/languages.js';

  // Multi-select combobox over afriso's 2,205 living African languages, with
  // bulk add by country. Options render on demand: 2,205 list items in the DOM
  // is slow to parse and pointless when only a handful are ever shown.
  const combo = document.getElementById('language-combo');

  if (combo) {
    const field = document.getElementById('language-field');
    const search = document.getElementById('language-search');
    const chipList = document.getElementById('language-chips');
    const hiddenCodes = document.getElementById('language-codes');
    const listbox = document.getElementById('language-listbox');
    const toggle = document.getElementById('language-toggle');
    const chevron = document.getElementById('language-chevron');
    const clearAll = document.getElementById('language-clear');

    const MAX_RESULTS = 60;
    // High enough for Nigeria's 562 languages, since bulk add by country is
    // the whole point of the country rows.
    const MAX_SELECTED = 600;
    const ACTIVE = ['bg-mist', 'text-forest-800'];

    const chosen = new Map();
    let results = [];
    let activeIndex = -1;

    // Strip accents so "sango" matches "Sängö" and "cote" matches "Côte".
    const normalize = (value) =>
      String(value).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

    const haystack = LANGUAGES.map((l) => normalize(l.name));

    // Languages grouped by country, so a country row knows what it would add.
    const BY_COUNTRY = new Map();
    for (const lang of LANGUAGES) {
      for (const cc of lang.countries) {
        if (!BY_COUNTRY.has(cc)) BY_COUNTRY.set(cc, []);
        BY_COUNTRY.get(cc).push(lang);
      }
    }

    const COUNTRIES = [...BY_COUNTRY.entries()]
      .map(([code, langs]) => ({
        kind: 'country',
        code,
        name: COUNTRY_NAMES[code] || code,
        langs,
      }))
      .sort((a, b) => a.name.localeCompare(b.name, 'en'));

    const countryHaystack = COUNTRIES.map((c) => normalize(c.name));
    const remaining = (country) => country.langs.filter((l) => !chosen.has(l.code));

    function matches(term) {
      const q = normalize(term.trim());
      const out = [];

      // Country rows come first: someone who typed a country name wants the
      // bulk action, not the handful of languages sharing that name.
      if (q) {
        for (let i = 0; i < COUNTRIES.length; i += 1) {
          if (!countryHaystack[i].includes(q)) continue;
          if (!remaining(COUNTRIES[i]).length) continue;
          out.push(COUNTRIES[i]);
        }
      }

      const byCode = [];
      const starts = [];
      const contains = [];

      for (let i = 0; i < LANGUAGES.length; i += 1) {
        const lang = LANGUAGES[i];
        if (chosen.has(lang.code)) continue;
        if (!q) {
          starts.push(lang);
        } else if (lang.code === q) {
          byCode.push(lang);
        } else if (haystack[i].startsWith(q)) {
          starts.push(lang);
        } else if (haystack[i].includes(q)) {
          contains.push(lang);
        }
        if (byCode.length + starts.length + contains.length >= MAX_RESULTS * 3) break;
      }

      return [...out, ...byCode, ...starts, ...contains].slice(0, MAX_RESULTS);
    }

    function renderChips() {
      chipList.replaceChildren();

      for (const lang of chosen.values()) {
        const chip = document.createElement('li');
        chip.className =
          'inline-flex items-center gap-1.5 pl-2.5 pr-1.5 py-1 rounded-md bg-mist text-forest-800 text-sm font-semibold';

        const label = document.createElement('span');
        label.textContent = lang.name;
        chip.append(label);

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'text-forest-800/60 hover:text-forest-800 transition-colors';
        remove.setAttribute('aria-label', `Remove ${lang.name}`);
        remove.textContent = '×';
        remove.addEventListener('click', () => {
          deselect(lang);
          search.focus();
        });
        chip.append(remove);
        chipList.append(chip);
      }

      hiddenCodes.value = [...chosen.keys()].join(',');
      search.placeholder = chosen.size
        ? 'Add another...'
        : 'Language or country, e.g. Yoruba or Ghana...';
      clearAll.classList.toggle('hidden', chosen.size < 2);
      clearAll.textContent = `Clear all (${chosen.size})`;
    }

    function renderOptions() {
      listbox.replaceChildren();

      for (const item of results) {
        const li = document.createElement('li');
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', 'false');

        if (item.kind === 'country') {
          const count = remaining(item).length;
          li.className = 'px-4 py-2 cursor-pointer border-b border-mist-200';

          const label = document.createElement('span');
          label.className = 'text-base font-semibold text-forest-800';
          label.textContent = `Add all languages in ${item.name}`;
          li.append(label);

          const meta = document.createElement('span');
          meta.className = 'block text-sm text-neutral-600';
          meta.textContent = `${count} language${count === 1 ? '' : 's'}`;
          li.append(meta);
        } else {
          li.className = 'px-4 py-2 cursor-pointer';

          const name = document.createElement('span');
          name.className = 'text-base text-ink-700';
          name.textContent = item.name;
          li.append(name);

          const where = item === OTHER_LANGUAGE ? '' : countryNamesFor(item);
          if (where) {
            const meta = document.createElement('span');
            meta.className = 'block text-sm text-neutral-600 truncate';
            meta.textContent = `${item.code} · ${where}`;
            li.append(meta);
          }
        }

        li.addEventListener('mousedown', (e) => {
          e.preventDefault();
          select(item);
        });
        li.addEventListener('mouseenter', () => setActive(results.indexOf(item)));
        listbox.append(li);
      }

      if (!results.length) {
        const li = document.createElement('li');
        li.className = 'px-4 py-2 text-base text-neutral-600';
        li.textContent = 'No match. Try a language name, ISO code, or country.';
        listbox.append(li);
      }

      setActive(results.length ? 0 : -1);
    }

    function setActive(index) {
      Array.from(listbox.children).forEach((li) => {
        li.classList.remove(...ACTIVE);
        li.setAttribute('aria-selected', 'false');
      });
      activeIndex = index;
      const li = listbox.children[index];
      if (!li) return;
      li.classList.add(...ACTIVE);
      li.setAttribute('aria-selected', 'true');
      li.scrollIntoView({ block: 'nearest' });
    }

    const isOpen = () => !listbox.classList.contains('hidden');

    function open() {
      listbox.classList.remove('hidden');
      search.setAttribute('aria-expanded', 'true');
      chevron.classList.add('rotate-180');
    }

    function close() {
      listbox.classList.add('hidden');
      search.setAttribute('aria-expanded', 'false');
      chevron.classList.remove('rotate-180');
    }

    function refresh(term) {
      results = matches(term);
      // Always leave a way out for a language afriso does not cover.
      if (!chosen.has(OTHER_LANGUAGE.code) && !results.includes(OTHER_LANGUAGE)) {
        results = [...results, OTHER_LANGUAGE];
      }
      renderOptions();
    }

    function add(lang) {
      if (chosen.size >= MAX_SELECTED || chosen.has(lang.code)) return;
      chosen.set(lang.code, lang);
    }

    function select(item) {
      if (!item) return;

      if (item.kind === 'country') {
        // Bulk add, then leave them as individual chips so any can be pruned.
        for (const lang of remaining(item)) add(lang);
      } else {
        add(item);
      }

      renderChips();
      // Clear the search so the next one can be typed straight away, and keep
      // the list open: picking several in a row is the common case here.
      search.value = '';
      refresh('');
      open();
    }

    function deselect(lang) {
      chosen.delete(lang.code);
      renderChips();
      refresh(search.value);
    }

    search.addEventListener('input', () => {
      refresh(search.value);
      open();
    });

    search.addEventListener('focus', () => {
      refresh(search.value);
      open();
    });

    search.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (!isOpen()) { refresh(search.value); open(); }
        if (!results.length) return;
        const step = e.key === 'ArrowDown' ? 1 : -1;
        setActive((activeIndex + step + results.length) % results.length);
      } else if (e.key === 'Enter') {
        if (isOpen()) {
          e.preventDefault();
          select(results[activeIndex]);
        }
      } else if (e.key === 'Backspace' && !search.value && chosen.size) {
        // Backspace on an empty box removes the last chip, as in any tag field.
        e.preventDefault();
        deselect([...chosen.values()].pop());
      } else if (e.key === 'Escape' || e.key === 'Tab') {
        close();
      }
    });

    // A half-typed search string is never left sitting in the box looking like
    // an answer; only chips count as selections.
    search.addEventListener('blur', () => {
      window.setTimeout(() => {
        const typed = normalize(search.value);
        if (!typed) return;
        const exact = LANGUAGES.find((l, i) => haystack[i] === typed || l.code === typed);
        if (exact) select(exact);
        search.value = '';
      }, 120);
    });

    clearAll.addEventListener('click', () => {
      chosen.clear();
      renderChips();
      refresh('');
      search.focus();
    });

    field.addEventListener('mousedown', (e) => {
      if (e.target === field || e.target === chipList) search.focus();
    });

    toggle.addEventListener('click', () => {
      if (isOpen()) close();
      else search.focus();
    });

    document.addEventListener('click', (e) => {
      if (!combo.contains(e.target)) close();
    });

    renderChips();
  }
</script>
