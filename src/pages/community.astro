---
import Base from '../layouts/Base.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const SLACK_INVITE = 'https://join.slack.com/t/africanlp/shared_invite/zt-488w1yzj6-ui~rrekZQmavOujYh6x_~w';
---

<Base
  title="Community | AfriSpeech"
  description="Join the Africa NLP community. Connect with researchers, engineers, and linguists building foundational tools for African languages."
>
  <Navigation slot="nav" />

  <section class="pt-24 pb-16 sm:pt-28 sm:pb-20 bg-mist">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl font-bold text-neutral-900 tracking-tight mb-4">Community</h1>
        <p class="text-lg text-neutral-600 leading-relaxed max-w-2xl">
          AfriSpeech hosts the Africa NLP community that brings together researchers, engineers,
          linguists, and builders working to make African languages thrive in AI. Our members are
          building the foundational tools that power Africa&rsquo;s AI. To join the community,
          please complete the form below.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-paper">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-xl">
        <form id="join-form" class="space-y-5" novalidate>
          <div>
            <label for="name" class="block text-sm font-semibold text-neutral-900 mb-1.5">Name</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              placeholder="Your full name"
              class="w-full px-4 py-3 text-base rounded-card border border-mist-200 bg-white text-ink-700 placeholder-sage focus:outline-none focus:border-forest transition-colors"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-neutral-900 mb-1.5">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="you@example.com"
              class="w-full px-4 py-3 text-base rounded-card border border-mist-200 bg-white text-ink-700 placeholder-sage focus:outline-none focus:border-forest transition-colors"
            />
            <p class="mt-1.5 text-sm text-neutral-600">
              Use the same email you would like to use to join our Slack community.
            </p>
          </div>

          <div>
            <label for="language-search" class="block text-sm font-semibold text-neutral-900 mb-1.5">
              Which language are you building for?
            </label>
            <div class="relative" id="language-combo">
              <input
                id="language-search"
                type="text"
                role="combobox"
                autocomplete="off"
                aria-expanded="false"
                aria-controls="language-listbox"
                aria-autocomplete="list"
                placeholder="Start typing a language or ISO code..."
                class="w-full pl-4 pr-10 py-3 text-base rounded-card border border-mist-200 bg-white text-ink-700 placeholder-sage focus:outline-none focus:border-forest transition-colors"
              />
              <input type="hidden" id="language-code" name="languageCode" value="" />
              <button
                type="button"
                id="language-toggle"
                tabindex="-1"
                aria-label="Show languages"
                class="absolute inset-y-0 right-0 flex items-center px-3 text-sage hover:text-forest transition-colors"
              >
                <svg id="language-chevron" class="w-4 h-4 transition-transform" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 7.5 10 12.5 15 7.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <ul
                id="language-listbox"
                role="listbox"
                aria-label="African languages"
                class="hidden absolute z-20 left-0 right-0 mt-1 max-h-72 overflow-y-auto rounded-card border border-mist-200 bg-white shadow-lg py-1"
              ></ul>
            </div>
            <p class="mt-1.5 text-sm text-neutral-600">
              Pick the main one. If you work across several, choose the closest and tell us more below.
            </p>
          </div>

          <div>
            <label for="reason" class="block text-sm font-semibold text-neutral-900 mb-1.5">Why do you want to join the community?</label>
            <textarea
              id="reason"
              name="reason"
              rows="4"
              required
              placeholder="Tell us what you are building or working on in African languages and NLP..."
              class="w-full px-4 py-3 text-base rounded-card border border-mist-200 bg-white text-ink-700 placeholder-sage focus:outline-none focus:border-forest transition-colors resize-y"
            ></textarea>
          </div>

          <p id="form-error" class="hidden text-base text-red-500"></p>

          <button
            type="submit"
            class="inline-flex items-center justify-center px-6 py-3 rounded-md bg-forest-700 text-white text-sm font-semibold hover:bg-forest-800 transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
          >
            Request to join
          </button>
        </form>

        <div id="join-success" class="hidden p-8 rounded-card border border-mist-200 bg-white">
          <h2 class="text-2xl font-bold text-neutral-900 mb-3">Thank you!</h2>
          <p class="text-base text-neutral-600 leading-relaxed mb-5">
            We have sent a welcome email to your inbox. To finish joining, click the button below
            to open your Slack invite.
          </p>
          <a
            id="join-invite"
            href={SLACK_INVITE}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center px-6 py-3 rounded-md bg-forest-700 text-white text-sm font-semibold hover:bg-forest-800 transition-colors"
          >
            Join the Africa NLP Slack
          </a>
          <p class="text-base text-neutral-600 leading-relaxed mt-5">
            Once you are in, introduce yourself on the <strong class="text-ink-700">#introductions</strong>
            channel and share a little about what you are doing in NLP.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<script>
  const form = document.getElementById('join-form');
  const errorBox = document.getElementById('form-error');
  const success = document.getElementById('join-success');

  if (form && success) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.add('hidden');
      const payload = {
        name: document.getElementById('name').value,
        email: document.getElementById('email').value,
        languageCode: document.getElementById('language-code').value,
        reason: document.getElementById('reason').value,
      };

      if (!payload.languageCode) {
        errorBox.textContent = 'Please choose a language from the list.';
        errorBox.classList.remove('hidden');
        document.getElementById('language-search').focus();
        return;
      }

      const btn = form.querySelector('button[type="submit"]');
      btn.disabled = true;
      btn.textContent = 'Sending...';

      try {
        const res = await fetch('/.netlify/functions/join-community', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          const invite = document.getElementById('join-invite');
          if (invite && data.slackInvite) invite.href = data.slackInvite;
          form.classList.add('hidden');
          success.classList.remove('hidden');
        } else {
          errorBox.textContent = data.error || 'Something went wrong. Please try again.';
          errorBox.classList.remove('hidden');
        }
      } catch (err) {
        errorBox.textContent = 'Could not reach the server. Please try again.';
        errorBox.classList.remove('hidden');
      }

      btn.disabled = false;
      btn.textContent = 'Request to join';
    });
  }
</script>

<script>
  import { LANGUAGES, OTHER_LANGUAGE, countryNamesFor } from '../data/languages.js';

  // Searchable language combobox over afriso's 2,205 living African languages.
  // Options are rendered on demand rather than up front: 2,205 list items in
  // the DOM is slow to parse and pointless when only a handful are ever shown.
  const combo = document.getElementById('language-combo');

  if (combo) {
    const search = document.getElementById('language-search');
    const hiddenCode = document.getElementById('language-code');
    const listbox = document.getElementById('language-listbox');
    const toggle = document.getElementById('language-toggle');
    const chevron = document.getElementById('language-chevron');

    const MAX_RESULTS = 60;
    const ACTIVE = ['bg-mist', 'text-forest-800'];

    let results = [];
    let activeIndex = -1;
    let selected = null;

    // Strip accents so "sango" matches "Sängö" and "ndebele" matches "isiNdebele".
    const normalize = (value) =>
      String(value).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

    const haystack = LANGUAGES.map((l) => normalize(l.name));

    function search_(term) {
      const q = normalize(term.trim());
      if (!q) return LANGUAGES.slice(0, MAX_RESULTS);

      // Exact code match first: someone typing "twi" wants Twi, not every
      // language whose name happens to contain those letters.
      const starts = [];
      const contains = [];
      const byCode = [];

      for (let i = 0; i < LANGUAGES.length; i += 1) {
        const lang = LANGUAGES[i];
        if (lang.code === q) {
          byCode.push(lang);
        } else if (haystack[i].startsWith(q)) {
          starts.push(lang);
        } else if (haystack[i].includes(q)) {
          contains.push(lang);
        }
        if (byCode.length + starts.length + contains.length >= MAX_RESULTS * 3) break;
      }

      return [...byCode, ...starts, ...contains].slice(0, MAX_RESULTS);
    }

    function render() {
      listbox.replaceChildren();

      for (const lang of results) {
        const li = document.createElement('li');
        li.className = 'px-4 py-2 cursor-pointer';
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', 'false');
        li.dataset.code = lang.code;

        const name = document.createElement('span');
        name.className = 'text-base text-ink-700';
        name.textContent = lang.name;
        li.append(name);

        const where = lang === OTHER_LANGUAGE ? '' : countryNamesFor(lang);
        if (where) {
          const meta = document.createElement('span');
          meta.className = 'block text-sm text-neutral-600 truncate';
          meta.textContent = `${lang.code} · ${where}`;
          li.append(meta);
        }

        li.addEventListener('mousedown', (e) => {
          e.preventDefault();
          choose(lang);
        });
        li.addEventListener('mouseenter', () => setActive(results.indexOf(lang)));
        listbox.append(li);
      }

      setActive(results.length ? 0 : -1);
    }

    function setActive(index) {
      Array.from(listbox.children).forEach((li) => {
        li.classList.remove(...ACTIVE);
        li.setAttribute('aria-selected', 'false');
      });
      activeIndex = index;
      const li = listbox.children[index];
      if (!li) return;
      li.classList.add(...ACTIVE);
      li.setAttribute('aria-selected', 'true');
      li.scrollIntoView({ block: 'nearest' });
    }

    const isOpen = () => !listbox.classList.contains('hidden');

    function open() {
      listbox.classList.remove('hidden');
      search.setAttribute('aria-expanded', 'true');
      chevron.classList.add('rotate-180');
    }

    function close() {
      listbox.classList.add('hidden');
      search.setAttribute('aria-expanded', 'false');
      chevron.classList.remove('rotate-180');
    }

    function refresh(term) {
      results = search_(term);
      // Always leave a way out for a language afriso does not cover.
      if (!results.includes(OTHER_LANGUAGE)) results = [...results, OTHER_LANGUAGE];
      render();
    }

    function choose(lang) {
      if (!lang) return;
      selected = lang;
      hiddenCode.value = lang.code;
      search.value = lang.name;
      close();
    }

    search.addEventListener('input', () => {
      // Typing invalidates the previous pick until a new one is committed.
      selected = null;
      hiddenCode.value = '';
      refresh(search.value);
      open();
    });

    search.addEventListener('focus', () => {
      refresh(selected ? '' : search.value);
      open();
    });

    search.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (!isOpen()) { refresh(selected ? '' : search.value); open(); }
        if (!results.length) return;
        const step = e.key === 'ArrowDown' ? 1 : -1;
        setActive((activeIndex + step + results.length) % results.length);
      } else if (e.key === 'Enter') {
        if (isOpen()) {
          e.preventDefault();
          choose(results[activeIndex]);
        }
      } else if (e.key === 'Escape' || e.key === 'Tab') {
        close();
      }
    });

    // On blur, keep the field honest: either it shows a committed selection or
    // it shows nothing. A half-typed search string is never left sitting there
    // looking like an answer.
    search.addEventListener('blur', () => {
      window.setTimeout(() => {
        if (selected) {
          search.value = selected.name;
          return;
        }
        const typed = normalize(search.value);
        const exact = LANGUAGES.find(
          (l, i) => haystack[i] === typed || l.code === typed,
        );
        if (exact) {
          choose(exact);
        } else if (search.value) {
          search.value = '';
        }
      }, 120);
    });

    toggle.addEventListener('click', () => {
      if (isOpen()) close();
      else search.focus();
    });

    document.addEventListener('click', (e) => {
      if (!combo.contains(e.target)) close();
    });
  }
</script>
