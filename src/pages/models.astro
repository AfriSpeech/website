---
import Base from '../layouts/Base.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import SpeechIdDemo from '../components/SpeechIdDemo.astro';
import models from '../data/models.json';

const withDemo = models.filter(m => m.has_demo);
const infoOnly = models.filter(m => !m.has_demo);
---

<Base title="Models & Demos" description="Try our NLP models for African languages. Live demos for language identification and more.">
  <Navigation slot="nav" />

  <section class="pt-24 pb-16 sm:pt-28 sm:pb-20 bg-mist">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl font-bold text-neutral-900 tracking-tight mb-4">Models & Demos</h1>
        <p class="text-lg text-neutral-600 leading-relaxed">
          Try our models live right here. Each demo runs on CPU and processes your audio directly.
        </p>
      </div>
    </div>
  </section>

  {
    withDemo.map((model, i) => (
      <section id={model.id} class={i % 2 === 0 ? "py-16 sm:py-20 bg-paper" : "py-16 sm:py-20 bg-mist"}>
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
            <div class="lg:col-span-1">
              <div class="lg:sticky lg:top-20">
                <h2 class="text-2xl font-semibold text-neutral-900 tracking-tight mb-3">{model.title}</h2>
                <p class="text-sm font-mono text-forest-700 mb-4">{model.subtitle}</p>
                <p class="text-base text-neutral-600 leading-relaxed mb-6">
                  {model.description}
                </p>
                <div class="space-y-3 mb-6">
                  {
                    model.bullets.map(bullet => (
                      <div class="flex items-center gap-3 text-base">
                        <span class="w-2 h-2 rounded-full bg-forest"></span>
                        <span class="text-ink-600">{bullet}</span>
                      </div>
                    ))
                  }
                </div>
                <div class="flex flex-wrap gap-2 mb-6">
                  {
                    model.tags.map(tag => (
                      <span class="text-xs px-2.5 py-1 rounded-md border border-neutral-200 bg-neutral-100 text-neutral-600 font-medium">{tag}</span>
                    ))
                  }
                </div>
                <div class="flex gap-4">
                  <a href={model.huggingface} target="_blank" rel="noopener" class="text-base font-bold text-forest-800">HuggingFace &rarr;</a>
                  {model.github && (
                    <a href={model.github} target="_blank" rel="noopener" class="text-base font-bold text-neutral-600 hover:text-ink-600">GitHub &rarr;</a>
                  )}
                </div>
              </div>
            </div>

            <div class="lg:col-span-2">
              <SpeechIdDemo />
            </div>
          </div>
        </div>
      </section>
    ))
  }

  {
    infoOnly.map(model => (
      <section class="py-16 sm:py-20 bg-mist">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="max-w-2xl">
            <h2 class="text-2xl font-semibold text-neutral-900 tracking-tight mb-3">{model.title}</h2>
            <p class="text-sm font-mono text-forest-700 mb-4">{model.subtitle}</p>
            <p class="text-base text-neutral-600 leading-relaxed mb-6">
              {model.description}
            </p>
            <div class="flex flex-wrap gap-2 mb-6">
              {
                model.tags.map(tag => (
                  <span class="text-xs px-2.5 py-1 rounded-md border border-neutral-200 bg-neutral-100 text-neutral-600 font-medium">{tag}</span>
                ))
              }
            </div>
            <a href={model.huggingface} target="_blank" rel="noopener" class="text-base font-bold text-forest-800">
              View on HuggingFace &rarr;
            </a>
          </div>
        </div>
      </section>
    ))
  }

  <Footer slot="footer" />
</Base>