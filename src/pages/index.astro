---
import Base from '../layouts/Base.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import FeatureCard from '../components/FeatureCard.astro';
import ModelCard from '../components/ModelCard.astro';
import { getTraffic } from '../lib/github-traffic.mjs';

const traffic = await getTraffic();
---

<Base title="AfriSpeech - Open-source NLP for Africa" appendSiteName={false}>
  <Navigation slot="nav" />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-ivory">
    <div class="absolute inset-0 opacity-5" style="background-image: url('/images/patterns/mudcloth.svg'); background-size: 80px;"></div>
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-24 sm:pt-40 sm:pb-32 relative z-10">
      <div class="max-w-3xl">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-earth-800 leading-tight mb-6">
          Every African language deserves representation in AI
        </h1>

        <p class="text-lg sm:text-xl text-baobab max-w-2xl mb-10 leading-relaxed">
          Open-source NLP models, datasets, and tools built for African languages.
          Try our demos right here, or dive into our research.
        </p>

        <div class="flex flex-col sm:flex-row items-start gap-4">
          <a href="/models" class="px-8 py-4 rounded-card bg-gold text-earth-800 font-bold text-base uppercase hover:bg-gold-500 transition-all hover:-translate-y-1 hover:shadow-lg">
            Try Live Demos
          </a>
          <a href="/datasets" class="px-8 py-4 rounded-card border-2 border-gold text-gold font-bold text-base uppercase hover:bg-gold hover:text-earth-800 transition-all">
            Explore Datasets
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="bg-savanna py-12">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <a href="/projects" class="group block">
          <div class="text-4xl font-bold text-earth-700 mb-1 group-hover:text-gold transition-colors">2,264</div>
          <div class="text-base text-baobab group-hover:text-gold transition-colors">Languages Supported</div>
        </a>
        <a href="/datasets" class="group block">
          <div class="text-4xl font-bold text-earth-700 mb-1 group-hover:text-gold transition-colors"><span data-dataset-downloads>3,088</span></div>
          <div class="text-base text-baobab group-hover:text-gold transition-colors">Dataset Downloads</div>
        </a>
        <a href="/models" class="group block">
          <div class="text-4xl font-bold text-earth-700 mb-1 group-hover:text-gold transition-colors"><span data-model-downloads>1,226</span></div>
          <div class="text-base text-baobab group-hover:text-gold transition-colors">Model Downloads</div>
        </a>
        <a href="https://github.com/AfriSpeech" target="_blank" rel="noopener" class="group block">
          <div class="text-4xl font-bold text-earth-700 mb-1 group-hover:text-gold transition-colors"><span data-github-clones>{traffic.clones.toLocaleString()}</span></div>
          <div class="text-base text-baobab group-hover:text-gold transition-colors">Repo Downloads</div>
        </a>
      </div>
    </div>
  </section>

  <!-- What We Do -->
  <section class="py-20 sm:py-24 bg-ivory">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="text-3xl sm:text-4xl font-bold text-earth-800 mb-4">Building NLP for Africa</h2>
        <p class="text-baobab max-w-2xl mx-auto text-base">
          From speech recognition to phoneme conversion, we create tools that make it easy to work with African languages in NLP.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <FeatureCard
          symbol="mate-masie"
          title="Language Identification"
          description="CPU-friendly, fast language ID for 1,386 African languages. Runs on a phone or laptop."
        />
        <FeatureCard
          symbol="sankofa"
          title="Corpus Building"
          description="Access monolingual and parallel data for 693 African languages from multiple sources."
        />
        <FeatureCard
          symbol="nkyinkyim"
          title="Phoneme Conversion"
          description="Rule-based grapheme-to-phoneme for 400+ languages, converting text to native orthography or IPA."
        />
        <FeatureCard
          symbol="funtunfunefu"
          title="Speech Data"
          description="Easy access to speech data across 142 languages for training TTS and ASR models."
        />
        <FeatureCard
          symbol="nyansapo"
          title="IPA Transcription"
          description="CTC phoneme recogniser trained on IPA transcriptions for 141 African languages."
        />
        <FeatureCard
          symbol="nkonsonkonson"
          title="Community Curation"
          description="Curated lists of NLP projects, communities, and resources across the African continent."
        />
      </div>
    </div>
  </section>

  <!-- Featured Model -->
  <section class="py-20 sm:py-24 bg-savanna">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-3xl sm:text-4xl font-bold text-earth-800 mb-4">Try It Now</h2>
        <p class="text-baobab max-w-2xl mx-auto text-base">
          Our flagship model identifies which of 1,386 African languages is being spoken in an audio clip. It runs on CPU.
        </p>
      </div>

      <div class="max-w-2xl mx-auto">
        <ModelCard
          name="African Speech ID"
          description="Identify the African language spoken in an audio clip. CPU-friendly, fast, covers 1,386 languages including dialects. Based on Omnilingual ASR with a lightweight classifier head."
          languages="1,386 African languages"
          tags={['Audio Classification', 'CPU-friendly', 'ONNX', 'Apache 2.0']}
          href="https://huggingface.co/AfriSpeech/african-speech-id"
          demoHref="/models#african-speech-id"
          downloads="67 downloads"
        />
      </div>

      <div class="text-center mt-8">
        <a href="/models" class="text-base font-bold text-gold hover:text-gold-600 uppercase">
          View all models &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Datasets -->
  <section class="py-20 sm:py-24 bg-ivory">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-3xl sm:text-4xl font-bold text-earth-800 mb-4">Open Datasets</h2>
        <p class="text-baobab max-w-2xl mx-auto text-base">
          Curated speech and text datasets covering hundreds of African languages, freely available on HuggingFace.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 rounded-card border border-savanna-200 bg-ivory hover:shadow-card-hover transition-all">
          <h3 class="text-lg font-bold text-earth-700 mb-2">Africa Corpus</h3>
          <p class="text-base text-baobab mb-3">16.6M rows &middot; 276 languages &middot; Monolingual and parallel data</p>
          <a href="https://huggingface.co/datasets/AfriSpeech/africa-corpus" target="_blank" rel="noopener" class="text-base font-bold text-gold hover:text-gold-600">View Dataset &rarr;</a>
        </div>
        <div class="p-6 rounded-card border border-savanna-200 bg-ivory hover:shadow-card-hover transition-all">
          <h3 class="text-lg font-bold text-earth-700 mb-2">African Speech IPA</h3>
          <p class="text-base text-baobab mb-3">776K rows &middot; 934 languages &middot; IPA phoneme transcriptions</p>
          <a href="https://huggingface.co/datasets/AfriSpeech/african-speech-ipa" target="_blank" rel="noopener" class="text-base font-bold text-gold hover:text-gold-600">View Dataset &rarr;</a>
        </div>
        <div class="p-6 rounded-card border border-savanna-200 bg-ivory hover:shadow-card-hover transition-all">
          <h3 class="text-lg font-bold text-earth-700 mb-2">Open Bible Speech African</h3>
          <p class="text-base text-baobab mb-3">553K rows &middot; 1.09K likes &middot; Bible audio across African languages</p>
          <a href="https://huggingface.co/datasets/AfriSpeech/open-bible-speech-african" target="_blank" rel="noopener" class="text-base font-bold text-gold hover:text-gold-600">View Dataset &rarr;</a>
        </div>
        <div class="p-6 rounded-card border border-savanna-200 bg-ivory hover:shadow-card-hover transition-all">
          <h3 class="text-lg font-bold text-earth-700 mb-2">African Transcribed Speech</h3>
          <p class="text-base text-baobab mb-3">552K rows &middot; 113 languages &middot; Parallel and monolingual</p>
          <a href="https://huggingface.co/datasets/AfriSpeech/african-transcribed-speech-monolingual" target="_blank" rel="noopener" class="text-base font-bold text-gold hover:text-gold-600">View Dataset &rarr;</a>
        </div>
      </div>

      <div class="text-center mt-8">
        <a href="/datasets" class="text-base font-bold text-gold hover:text-gold-600 uppercase">
          View all datasets &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Open Source Projects -->
  <section class="py-20 sm:py-24 bg-savanna">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-3xl sm:text-4xl font-bold text-earth-800 mb-4">Our Projects</h2>
        <p class="text-baobab max-w-2xl mx-auto text-base">
          Tools built by the community, for the community. All code is open-source on GitHub.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-card border border-savanna-200 bg-ivory hover:shadow-card-hover transition-all">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-lg font-bold text-earth-700">africa-corpus-builder</h3>
            <span class="text-sm text-baobab">14 stars</span>
          </div>
          <p class="text-base text-baobab mb-4">Get access to monolingual and parallel data for 693 African languages</p>
          <a href="https://github.com/AfriSpeech/africa-corpus-builder" target="_blank" rel="noopener" class="text-base font-bold text-gold hover:text-gold-600">View Repo &rarr;</a>
        </div>
        <div class="p-6 rounded-card border border-savanna-200 bg-ivory hover:shadow-card-hover transition-all">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-lg font-bold text-earth-700">africa-g2p</h3>
            <span class="text-sm text-baobab">14 stars</span>
          </div>
          <p class="text-base text-baobab mb-4">Rule-based grapheme-to-phoneme for 400+ African languages</p>
          <a href="https://github.com/AfriSpeech/africa-g2p" target="_blank" rel="noopener" class="text-base font-bold text-gold hover:text-gold-600">View Repo &rarr;</a>
        </div>
        <div class="p-6 rounded-card border border-savanna-200 bg-ivory hover:shadow-card-hover transition-all">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-lg font-bold text-earth-700">afrispeech-selector</h3>
            <span class="text-sm text-baobab">14 stars</span>
          </div>
          <p class="text-base text-baobab mb-4">Easy access to speech data across 142 African languages for TTS and ASR</p>
          <a href="https://github.com/AfriSpeech/afrispeech-selector" target="_blank" rel="noopener" class="text-base font-bold text-gold hover:text-gold-600">View Repo &rarr;</a>
        </div>
      </div>

      <div class="text-center mt-8">
        <a href="/projects" class="text-base font-bold text-gold hover:text-gold-600 uppercase">
          View all projects &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 sm:py-24 bg-ivory">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-earth-700 rounded-card p-10 sm:p-14 relative overflow-hidden">
        <div class="absolute inset-0 opacity-10" style="background-image: url('/images/patterns/mudcloth.svg'); background-size: 60px;"></div>
        <div class="max-w-2xl relative z-10">
          <h2 class="text-3xl sm:text-4xl font-bold text-ivory mb-4">Get Involved</h2>
          <p class="text-ivory-200 mb-8 leading-relaxed text-base">
            We welcome contributions from developers, linguists, and researchers working on African language technology.
          </p>
          <div class="flex flex-col sm:flex-row items-start gap-4">
            <a href="https://github.com/AfriSpeech" target="_blank" rel="noopener" class="px-8 py-4 rounded-card bg-gold text-earth-800 font-bold text-base uppercase hover:bg-gold-500 transition-all hover:-translate-y-1">
              Contribute on GitHub
            </a>
            <a href="mailto:afrispeech@gmail.com" class="px-8 py-4 rounded-card border-2 border-earth-600 text-ivory-200 font-bold text-base uppercase hover:border-gold hover:text-gold transition-all">
              Email Us
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<script>
  (async () => {
    try {
      const [ds, ms] = await Promise.all([
        fetch('https://huggingface.co/api/datasets?author=AfriSpeech&limit=50').then(r => r.json()),
        fetch('https://huggingface.co/api/models?author=AfriSpeech&limit=50').then(r => r.json()),
      ]);
      const dsTotal = ds.reduce((s, d) => s + (d.downloads || 0), 0);
      const msTotal = ms.reduce((s, m) => s + (m.downloads || 0), 0);
      const set = (sel, n) => {
        const el = document.querySelector(sel);
        if (el) el.textContent = n.toLocaleString();
      };
      set('[data-dataset-downloads]', dsTotal);
      set('[data-model-downloads]', msTotal);
      try {
        const gh = await fetch('/.netlify/functions/github-traffic').then(r => r.json());
        if (gh.configured && gh.clones > 0) set('[data-github-clones]', gh.clones);
      } catch (e) {}
    } catch (e) {}
  })();
</script>
