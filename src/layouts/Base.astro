---
interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Set false when `title` is already the complete title (e.g. the homepage). */
  appendSiteName?: boolean;
  /**
   * Show the Listen button. Off by default: it reads the page it is on, so a
   * page with no prose on it would only offer a button that cannot work.
   */
  listen?: boolean;
  /** Keep the page out of search results, for utility pages. */
  noindex?: boolean;
}

import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';

const { title, listen = false, noindex = false, description = 'Building open-source NLP tools for African languages. Models, datasets, and demos for 1,386 African languages.', image = '/images/afrispeech-logo.png', appendSiteName = true } = Astro.props;
const pageTitle = appendSiteName ? `${title} | AfriSpeech` : title;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

/* The widget is one file and reads the page in the reader's own browser, so it
   needs to know only which service to talk to. There is deliberately no default
   here: a widget pointed at the wrong host fails in the reader's browser, long
   after the deploy, where nobody is watching. Failing the build puts the problem
   in front of whoever is deploying instead. */
const listenEndpoint = (import.meta.env.PUBLIC_LISTEN_ENDPOINT || '').trim();
const listenKey = (import.meta.env.PUBLIC_LISTEN_API_KEY || '').trim();

/* The widget itself lives in the AfriSpeech/web-tts repository now, not here,
   and is served straight off its `main` branch through jsDelivr rather than
   copied into this site's `public/`. That means a push to web-tts is what a
   reader gets here too, once jsDelivr's cache catches up (observed anywhere
   from under a minute to a couple of minutes after a purge; longer if nobody
   purges and it is just left to expire), with nothing to keep in sync on this
   side. Pin this to a commit (`@<sha>` in place of `@main`) instead if a
   specific, unambiguous version matters more than always being current. */
const listenWidgetUrl = 'https://cdn.jsdelivr.net/gh/AfriSpeech/web-tts@main/public/afrispeech-listen.js';

if (listen && !listenEndpoint) {
  throw new Error(
    'PUBLIC_LISTEN_ENDPOINT is not set, but this page enables the Listen ' +
    `widget (${Astro.url.pathname}). Set it to the URL of the synthesis ` +
    'service, or pass listen={false} to opt this page out.',
  );
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.url)} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    {listen && (
      <script
        src={listenWidgetUrl}
        data-endpoint={listenEndpoint}
        data-key={listenKey}
        defer
      />
    )}
  </head>
  <body class="bg-paper text-ink-500 font-sans antialiased">
    <slot name="nav" />
    <main>
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  @layer base {
    html { color-scheme: light; scroll-behavior: smooth; }
    body { font-size: 16px; line-height: 1.65; background: #FAFAFA; overflow-x: clip; }
    ::selection { background: rgba(82, 183, 136, 0.3); color: #0A281A; }

    h1, h2, h3, h4, h5, h6 {
      color: #343B36;
      font-weight: 700;
      margin-top: 0;
    }

    a {
      transition: all 0.3s ease-out 0s;
    }
    a:hover {
      text-decoration: none;
    }
  }
</style>
