---
interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Set false when `title` is already the complete title (e.g. the homepage). */
  appendSiteName?: boolean;
}

import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';

const { title, description = 'Building open-source NLP tools for African languages. Models, datasets, and demos for 1,386 African languages.', image = '/images/afrispeech-logo.png', appendSiteName = true } = Astro.props;
const pageTitle = appendSiteName ? `${title} | AfriSpeech` : title;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.url)} />

    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="bg-paper text-ink-500 font-sans antialiased">
    <slot name="nav" />
    <main>
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  @layer base {
    html { color-scheme: light; scroll-behavior: smooth; }
    body { font-size: 16px; line-height: 1.65; background: #FAFAFA; overflow-x: clip; }
    ::selection { background: rgba(82, 183, 136, 0.3); color: #0A281A; }

    h1, h2, h3, h4, h5, h6 {
      color: #343B36;
      font-weight: 700;
      margin-top: 0;
    }

    a {
      transition: all 0.3s ease-out 0s;
    }
    a:hover {
      text-decoration: none;
    }
  }
</style>
