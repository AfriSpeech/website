---
import AdinkraIcon from './AdinkraIcon.astro';

interface Props {
  symbol?: string;
  icon?: string;
  title: string;
  description: string;
}

const { symbol, icon, title, description } = Astro.props;
---

<div class="group p-8 rounded-card border border-savanna-200 bg-ivory hover:shadow-card-hover hover:border-gold-200 transition-all">
  <div class="w-14 h-14 rounded-card bg-gold-50 flex items-center justify-center text-gold mb-5">
    {symbol ? (
      <AdinkraIcon symbol={symbol} size={34} />
    ) : (
      <span class="text-2xl">{icon}</span>
    )}
  </div>
  <h3 class="text-xl font-bold text-earth-700 mb-3">{title}</h3>
  <p class="text-base text-baobab leading-relaxed">{description}</p>
</div>
