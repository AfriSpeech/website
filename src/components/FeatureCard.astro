---
interface Props {
  icon?: string;
  title: string;
  description: string;
}

const { icon = 'globe', title, description } = Astro.props;

const icons: Record<string, string> = {
  globe: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
  database: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 5v14a9 3 0 0 1-18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/>',
  swap: '<path d="M4 17h16"/><path d="M20 17l-3-3"/><path d="M20 17l-3 3"/><path d="M20 7H4"/><path d="M4 7l3-3"/><path d="M4 7l3 3"/>',
  waveform: '<path d="M12 3v18"/><path d="M8 7v10"/><path d="M16 7v10"/><path d="M4 10v4"/><path d="M20 10v4"/>',
  file: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h5"/>',
  folder: '<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>',
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
};
---

<div class="group p-8 rounded-card border border-neutral-200 bg-white hover:border-neutral-300 transition-colors">
  <div class="w-14 h-14 flex items-center justify-center text-forest-700 mb-5">
    <svg
      class="w-9 h-9"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      set:html={icons[icon] ?? icons.globe}
    />
  </div>
  <h3 class="text-xl font-semibold text-neutral-900 mb-3">{title}</h3>
  <p class="text-base text-neutral-600 leading-relaxed">{description}</p>
</div>