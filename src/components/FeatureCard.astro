---
import AdinkraIcon from './AdinkraIcon.astro';

interface Props {
  symbol?: string;
  icon?: string;
  title: string;
  description: string;
}

const { symbol, icon, title, description } = Astro.props;
---

<div class="group p-8 rounded-card border border-neutral-200 bg-white hover:border-neutral-300 transition-colors">
  <div class="w-14 h-14 flex items-center justify-center text-black mb-5">
    {symbol ? (
      <AdinkraIcon symbol={symbol} size={34} />
    ) : (
      <span class="text-2xl">{icon}</span>
    )}
  </div>
  <h3 class="text-xl font-semibold text-neutral-900 mb-3">{title}</h3>
  <p class="text-base text-neutral-600 leading-relaxed">{description}</p>
</div>
