---
// Animated 3-curve sound wave echoing the AfriSpeech emblem's waves,
// with the AfriSpeech map image on its left. Pure CSS animation — no video.
const duration = 2.6;
const waves = [
  { d: 'M40 60 Q120 100 40 140', color: '#2D6A4F', delay: 0 },
  { d: 'M40 40 Q150 100 40 160', color: '#52B788', delay: duration * 0.33 },
  { d: 'M40 20 Q180 100 40 180', color: '#74C69D', delay: duration * 0.66 },
];
---

<div
  class="flex items-center gap-2 sm:gap-3 pointer-events-none select-none max-w-full"
  aria-hidden="true"
>
  <img
    src="/images/afrispeech-map.png"
    alt=""
    width="196"
    height="191"
    class="h-28 sm:h-32 md:h-36 lg:h-32 xl:h-44 w-auto flex-shrink-0 object-contain"
  />
  <svg
    class="w-44 sm:w-52 md:w-60 lg:w-52 xl:w-72 h-auto aspect-square flex-shrink-0"
    viewBox="0 0 220 220"
    fill="none"
  >
    {waves.map(w => (
      <path
        class="hero-wave"
        d={w.d}
        stroke={w.color}
        stroke-width="4"
        stroke-linecap="round"
        style={`--delay:${w.delay}s`}
      />
    ))}
  </svg>
</div>

<style is:global>
  .hero-wave {
    animation: hero-wave-grow 2.6s ease-out infinite;
    animation-delay: var(--delay);
    transform-box: view-box;
    transform-origin: 40px 100px;
  }
  @keyframes hero-wave-grow {
    0% { transform: scale(0.3); opacity: 0; }
    20% { opacity: 0.9; }
    100% { transform: scale(1.25); opacity: 0; }
  }
</style>