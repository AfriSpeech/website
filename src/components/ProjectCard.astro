---
interface Props {
  name: string;
  description: string;
  downloads: number;
  language: string;
  href: string;
  tags?: string[];
}

const { name, description, downloads, language, href, tags = [] } = Astro.props;
---

<div class="group p-6 rounded-card border border-mist-200 bg-paper hover:shadow-card-hover hover:border-forest-200 transition-all" data-repo={name}>
  <div class="flex items-start justify-between mb-2">
    <h3 class="text-lg font-bold text-ink-700 group-hover:text-forest-700 transition-colors">{name}</h3>
    <div class="flex items-center gap-1 text-sm text-sage shrink-0 ml-3" title="Repository downloads (clones) in the last 14 days">
      <svg class="w-4 h-4 text-forest-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"/></svg>
      <span class="download-count">{downloads.toLocaleString()}</span>
    </div>
  </div>
  <p class="text-base text-sage leading-relaxed mb-3">{description}</p>
  <div class="flex items-center gap-3 text-sm text-sage mb-3">
    <span class="flex items-center gap-1.5">
      <span class="w-2 h-2 rounded-full bg-forest"></span>
      {language}
    </span>
  </div>
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-4">
      {tags.map(tag => (
        <span class="text-sm px-3 py-1 rounded-card bg-forest-50 text-forest-700 font-semibold">{tag}</span>
      ))}
    </div>
  )}
  <a href={href} target="_blank" rel="noopener" class="text-base font-bold text-forest-700 hover:text-forest-800">
    View Repository &rarr;
  </a>
</div>
