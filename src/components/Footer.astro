---
const year = new Date().getFullYear();
---

<footer class="bg-black text-neutral-200">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <div class="md:col-span-2">
        <a href="/" class="inline-flex items-center gap-3 mb-5 group">
          <img src="/images/afrispeech-emblem.svg" alt="" width="135" height="94" class="h-10 w-auto" />
          <span class="text-2xl font-extrabold tracking-tight text-neutral-100 group-hover:text-forest-300 transition-colors">AfriSpeech</span>
        </a>
        <p class="text-neutral-400 text-base max-w-sm leading-relaxed">
          Building open-source NLP tools for African languages. Every African language deserves representation in AI.
        </p>
        <div class="flex gap-3 mt-6">
          <a href="https://github.com/AfriSpeech" target="_blank" rel="noopener" class="w-9 h-9 rounded-card bg-white/5 flex items-center justify-center text-forest-300 hover:bg-forest-400 hover:text-black transition-all" aria-label="GitHub">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          </a>
          <a href="https://www.linkedin.com/company/afrispeech/" target="_blank" rel="noopener" class="w-9 h-9 rounded-card bg-white/5 flex items-center justify-center text-forest-300 hover:bg-forest-400 hover:text-black transition-all" aria-label="LinkedIn">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="mailto:hello@afrispeech.org" class="w-9 h-9 rounded-card bg-white/5 flex items-center justify-center text-forest-300 hover:bg-forest-400 hover:text-black transition-all" aria-label="Email">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="text-lg font-medium text-white mb-5">Research</h4>
        <ul class="space-y-3 text-base">
          <li><a href="/models" class="text-neutral-400 hover:text-forest-300">Models</a></li>
          <li><a href="/datasets" class="text-neutral-400 hover:text-forest-300">Datasets</a></li>
          <li><a href="/projects" class="text-neutral-400 hover:text-forest-300">Projects</a></li>
          <li><a href="/blog" class="text-neutral-400 hover:text-forest-300">Blog</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-lg font-medium text-white mb-5">Connect</h4>
        <ul class="space-y-3 text-base">
          <li><a href="https://github.com/AfriSpeech" target="_blank" rel="noopener" class="text-neutral-400 hover:text-forest-300">GitHub</a></li>
          <li><a href="https://www.linkedin.com/company/afrispeech/" target="_blank" rel="noopener" class="text-neutral-400 hover:text-forest-300">LinkedIn</a></li>
          <li><a href="mailto:hello@afrispeech.org" class="text-neutral-400 hover:text-forest-300">hello@afrispeech.org</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-neutral-800 bg-black">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-sm text-neutral-400">&copy; {year} AfriSpeech. All models and datasets are open-source.</p>
      <div class="flex gap-6 text-sm">
        <a href="/about" class="text-neutral-400 hover:text-forest-300">About</a>
        <a href="https://github.com/AfriSpeech" target="_blank" rel="noopener" class="text-neutral-400 hover:text-forest-300">GitHub</a>
      </div>
    </div>
  </div>
</footer>
