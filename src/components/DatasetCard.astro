---
interface Props {
  name: string;
  description: string;
  rows: string;
  languages: string;
  downloads: number;
  href: string;
  tags?: string[];
}

const { name, description, rows, languages, downloads, href, tags = [] } = Astro.props;
const hfId = href.replace('https://huggingface.co/datasets/', '');
---

<div class="group p-6 rounded-card border border-savanna-200 bg-ivory hover:shadow-card-hover hover:border-gold-200 transition-all">
  <div class="flex items-start justify-between mb-2">
    <h3 class="text-lg font-bold text-earth-700 group-hover:text-gold transition-colors leading-tight">{name}</h3>
    <div class="flex items-center gap-1 text-sm text-baobab shrink-0 ml-3" data-hf={hfId}>
      <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
      <span class="download-count">{downloads.toLocaleString()}</span>
    </div>
  </div>
  <p class="text-base text-baobab leading-relaxed mb-3">{description}</p>
  <div class="flex items-center gap-4 text-sm text-baobab mb-3">
    <span>{rows} rows</span>
    <span>{languages} languages</span>
  </div>
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-4">
      {tags.map(tag => (
        <span class="text-sm px-3 py-1 rounded-card bg-gold-50 text-gold font-semibold">{tag}</span>
      ))}
    </div>
  )}
  <a href={href} target="_blank" rel="noopener" class="text-base font-bold text-gold hover:text-gold-600">
    View Dataset &rarr;
  </a>
</div>