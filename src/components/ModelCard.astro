---
interface Props {
  name: string;
  description: string;
  languages: string;
  tags: string[];
  href: string;
  demoHref?: string;
  downloads?: string;
}

const { name, description, languages, tags, href, demoHref, downloads } = Astro.props;
---

<div class="group p-8 rounded-card border border-neutral-200 bg-white hover:border-neutral-300 transition-colors">
  <div class="flex items-start justify-between mb-3">
    <div>
      <h3 class="text-xl font-semibold text-forest-800 transition-colors">{name}</h3>
      <p class="text-sm font-mono text-neutral-600 mt-1">{languages}</p>
    </div>
    {downloads && (
      <span class="text-sm text-neutral-600 bg-neutral-100 px-3 py-1 rounded-md">{downloads}</span>
    )}
  </div>
  <p class="text-base text-neutral-600 leading-relaxed mb-5">{description}</p>
  <div class="flex flex-wrap gap-2 mb-5">
    {tags.map(tag => (
      <span class="text-xs px-2.5 py-1 rounded-md border border-neutral-200 bg-neutral-100 text-neutral-600 font-medium">{tag}</span>
    ))}
  </div>
  <div class="flex gap-4">
    <a href={href} target="_blank" rel="noopener" class="text-sm font-medium text-forest-800">
      View on HuggingFace &rarr;
    </a>
    {demoHref && (
      <a href={demoHref} class="text-sm font-medium text-neutral-600 hover:text-neutral-700">
        Try Demo &rarr;
      </a>
    )}
  </div>
</div>
