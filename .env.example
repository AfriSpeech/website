# Copy to .env for local Netlify Functions testing (not required for astro dev).
# Create a GitHub PAT with `repo` scope (or fine-grained token with push access
# to the AfriSpeech org repos) and set it here / in Netlify env vars.
GITHUB_TOKEN=

# Brevo transactional email (community join form welcome message).
BREVO_API_KEY=
# Must be a verified sender in Brevo. Defaults to community@afrispeech.org.
BREVO_FROM_EMAIL=
# Set to 1 to return Brevo's raw error in the response when a send fails.
DEBUG_EMAIL=

# Google Sheet logging for the community join form.
# JOIN_SHEET_URL is the Apps Script web app /exec URL; the secret must match
# SECRET in scripts/join-community-sheet.gs.
JOIN_SHEET_URL=
JOIN_SHEET_SECRET=

# Listen widget, loaded into <head> on pages that have prose to read.
# Where the synthesis service is. There is no default: a page that enables the
# widget and no endpoint fails the build rather than shipping a button that
# cannot work.
# PUBLIC_ is Astro's prefix for anything readable in the browser.
PUBLIC_LISTEN_ENDPOINT=
# The browser key. Not a secret: anyone can read it from the page source, and
# the service's origin allowlist is what actually keeps other sites out.
PUBLIC_LISTEN_API_KEY=
